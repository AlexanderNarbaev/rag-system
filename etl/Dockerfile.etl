# etl/Dockerfile.etl
# Docker image for running the RAG system ETL pipeline
# Models must be downloaded beforehand:
#   python -m spacy download ru_core_news_sm
#   python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-m3')"
#   and the cache copied to /model_cache at build time (see below)

FROM python:3.14-slim

# Install system dependencies (for compiling some packages)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the requirements file
COPY etl/requirements_etl.txt .

# Install Python packages
RUN pip install --no-cache-dir -r requirements_etl.txt

# Copy the ETL source code
COPY etl/ /app/etl/
COPY scripts/ /app/scripts/

# Create data directories
RUN mkdir -p /data/raw /data/chunks /data/hot_chunks /data/cold_chunks /data/cold_lake /data/entity_cache /wal

# Python environment variables (disable bytecode and log buffering)
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Copy pre-downloaded model caches (offline)
# COPY sources must live inside the build context (repo root), so host paths
# cannot be used directly. Place the caches under etl/model_cache/ before the
# build, or point the build arg at another in-context directory:
#   docker build --build-arg MODEL_CACHE_DIR=etl/model_cache -f etl/Dockerfile.etl .
# Expected contents:
#   - spaCy: spacy/... (from ~/.local/share/spacy or site-packages)
#   - sentence-transformers: huggingface/hub/... (from ~/.cache/huggingface)
ARG MODEL_CACHE_DIR=etl/model_cache
COPY ${MODEL_CACHE_DIR} /root/.cache/

# Entry point — the main orchestrator
ENTRYPOINT ["python", "-m", "etl.scheduler.run_etl"]
# Default parameters (can be overridden via the command line)
CMD ["--config", "/app/etl/config/etl_config.yaml"]