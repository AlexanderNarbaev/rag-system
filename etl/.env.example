# ───── RAG ETL — Configuration Template ─────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# These variables are substituted into etl/config/etl_config.yaml
# via ${VAR:-default} placeholders. NEVER commit .env with real secrets!

# ── Remote embedder (OpenAI-compatible /v1/embeddings) ───────────────────────
EMBEDDER_ENDPOINT=http://rag-proxy:8080/v1
EMBEDDER_MODEL=BAAI/bge-m3
EMBEDDER_API_KEY=

# ── Remote reranker ──────────────────────────────────────────────────────────
RERANKER_ENDPOINT=http://rag-proxy:8080/v1/rerank
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=

# ── SLM (lightweight model for entity extraction / enrichment) ───────────────
SLM_ENDPOINT=http://rag-proxy:8080/v1
SLM_MODEL=qwen2.5-3b
SLM_API_KEY=

# ── Chunk enrichment (defaults to SLM_* above if unset) ──────────────────────
# SLM_ENRICHMENT_ENDPOINT=
# SLM_ENRICHMENT_MODEL=

# ── Data source credentials (fill in what you use) ───────────────────────────
# CONFLUENCE_URL=
# CONFLUENCE_TOKEN=
# JIRA_URL=
# JIRA_TOKEN=
# GITLAB_URL=
# GITLAB_TOKEN=

# ── Infrastructure ───────────────────────────────────────────────────────────
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# REDIS_URL=redis://localhost:6379
